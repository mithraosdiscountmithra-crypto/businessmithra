# Copy these names into Render > Environment. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
JWT_SECRET="put-a-long-random-string-of-at-least-32-characters-here"
NODE_ENV="production"
# Optional – for direct photo upload in Items / Online Shop (cloudinary.com, free plan)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional – WhatsApp OTP login for shop customers (AiSensy API campaign with an Authentication template)
AISENSY_API_KEY=""
AISENSY_OTP_CAMPAIGN=""
# Super admin (BusinessMithra platform owner) – login at /admin
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""   # at least 10 characters
# Shown to vendors on Plan & Billing (how to pay you)
PLATFORM_UPI=""
PLATFORM_PHONE=""
PLATFORM_NAME="BusinessMithra"
# Optional – send bill PDF straight to customer's WhatsApp (AiSensy API campaign, Utility template with DOCUMENT header,
# body variables: {{1}} customer name, {{2}} shop name, {{3}} bill number, {{4}} amount)
AISENSY_BILL_CAMPAIGN=""
# Your real domain once connected (used in sitemap / Google links), e.g. https://businessmithra.in
PUBLIC_URL=""
# Optional – one-click vendor domain setup from Super Admin
RENDER_API_KEY=""        # Render → Account Settings → API Keys
HOSTINGER_API_TOKEN=""   # Hostinger hPanel → Account → API
# WhatsApp alert to shop owner on every new online order (AiSensy template with 4 variables:
# {{1}} shop name, {{2}} order number, {{3}} customer name & phone, {{4}} amount / type)
AISENSY_ORDER_CAMPAIGN=
# Marketing campaigns sent automatically (AiSensy MARKETING template, 4 variables:
# {{1}} customer name, {{2}} shop name, {{3}} offer message, {{4}} shop link)
AISENSY_PROMO_CAMPAIGN=
# Max automatic campaign messages per shop per month (each costs WhatsApp charges)
WA_CAMPAIGN_MONTHLY_LIMIT=300
# Automatic birthday wishes (AiSensy template, 3 variables: {{1}} customer name, {{2}} shop name, {{3}} offer)
AISENSY_WISH_CAMPAIGN=
# Razorpay (BusinessMithra's own account). Test keys (rzp_test_…) need no KYC.
# With test keys, every shop can also try online payment using these keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → URL: https://<your-app>/api/razorpay/webhook, events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=
