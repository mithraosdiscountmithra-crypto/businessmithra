# Copy these names into Render > Environment. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
JWT_SECRET="put-a-long-random-string-of-at-least-32-characters-here"
NODE_ENV="production"
# Optional – for direct photo upload in Items / Online Shop (cloudinary.com, free plan)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional – WhatsApp OTP login for shop customers (AiSensy API campaign with an Authentication template)
AISENSY_API_KEY=""
AISENSY_OTP_CAMPAIGN=""
# Super admin (BusinessMithra platform owner) – login at /admin
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""   # at least 10 characters
# Shown to vendors on Plan & Billing (how to pay you)
PLATFORM_UPI=""
PLATFORM_PHONE=""
PLATFORM_NAME="BusinessMithra"
# Optional – send bill PDF straight to customer's WhatsApp (AiSensy API campaign, Utility template with DOCUMENT header,
# body variables: {{1}} customer name, {{2}} shop name, {{3}} bill number, {{4}} amount)
AISENSY_BILL_CAMPAIGN=""
# Your real domain once connected (used in sitemap / Google links), e.g. https://businessmithra.in
PUBLIC_URL=""
# Optional – one-click vendor domain setup from Super Admin
RENDER_API_KEY=""        # Render → Account Settings → API Keys
HOSTINGER_API_TOKEN=""   # Hostinger hPanel → Account → API
