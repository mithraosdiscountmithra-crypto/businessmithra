// BusinessMithra database schema – Phase 1A (foundation)
// RULE: every business-owned table has businessId and every query filters by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id          String           @id @default(cuid())
  name        String
  type        String // retail, restaurant, salon, clinic, services, wholesale, manufacturing, education, others
  phone       String
  email       String?
  gstin       String?
  address     String?
  city        String?
  state       String?
  plan        String           @default("trial") // trial, free, basic, pro
  trialEndsAt DateTime
  planEndsAt  DateTime?        // paid plan valid till (null for trial/free)
  planCycle   String?          // monthly, yearly
  adminNote   String?          // private note by BusinessMithra super admin
  status      String           @default("active") // active, blocked
  invoicePrefix String         @default("INV-")
  nextInvoiceNo Int            @default(1)
  quotePrefix   String         @default("QT-")
  nextQuoteNo   Int            @default(1)
  invoiceTerms  String?
  bankDetails   String?
  // Online shop
  slug          String?        @unique
  shopEnabled   Boolean        @default(false)
  shopTagline   String?
  shopAbout     String?
  shopLogo      String?
  shopCover     String?
  shopColor     String         @default("#3730A3")
  shopTimings   String?
  upiId         String?
  allowPickup   Boolean        @default(true)
  allowDelivery Boolean        @default(false)
  deliveryFee   Decimal        @default(0) @db.Decimal(12, 2)
  minOrder      Decimal        @default(0) @db.Decimal(12, 2)
  allowBooking  Boolean        @default(false)
  allowTable    Boolean        @default(false) // restaurant table booking
  shopLat       Float?
  shopLng       Float?
  shopMapUrl    String?
  nextOrderNo   Int            @default(1)
  nextCreditNo  Int            @default(1)
  shopGallery   String[]       @default([]) // photos for the shop website
  // Delivery speeds (vendor chooses which to offer and the charges)
  normalDelivery Boolean       @default(true)
  normalEta     String         @default("Same day") // e.g. 1 – 2 hr
  morningDelivery Boolean      @default(false)
  morningFee    Decimal        @default(0) @db.Decimal(10, 2)
  morningCutoff String         @default("22:00") // order before this time → delivered next morning
  morningSlot   String         @default("6 – 9 AM")
  fastDelivery  Boolean        @default(false)
  fastFee       Decimal        @default(0) @db.Decimal(10, 2) // extra on top of the normal delivery fee
  fastEta       String         @default("30 – 45 min")
  showLocation  Boolean        @default(true) // false = location used only for delivery planning, hidden from customers
  shopTemplate  String         @default("classic") // website design: classic, modern, bold, elegant, fresh
  shopSince     Int?           // year started (shown as trust badge)
  shopInstagram String?
  shopFacebook  String?
  shopYoutube   String?
  allowOnlinePay Boolean       @default(false) // Razorpay in the online shop
  allowCod      Boolean        @default(true)  // cash on delivery / pay at shop
  allowUpiPay   Boolean        @default(true)  // customer pays to the shop's UPI ID (manual check)
  rzpKeyId      String?
  rzpKeySecret  String?        // encrypted
  autoSendPaidBill Boolean     @default(true) // WhatsApp the PDF automatically once a bill is fully paid
  wishesEnabled Boolean        @default(false)
  wishOffer     String?        // e.g. "10% off this week"
  lastWishDay   String?        // YYYY-MM-DD (IST) when birthday wishes last ran
  orderAlertPhone String?      // WhatsApp number for new-order alerts (default: business phone)
  membershipsEnabled Boolean   @default(false)
  customDomain       String?   // (unique, checked in code) vendor's own domain, e.g. www.srisaitextiles.in
  customDomainStatus String?   // requested, live
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  roles       Role[]
  modules     BusinessModule[]
  logs        ActivityLog[]
  customers   Customer[]
  leads       Lead[]
  followUps   FollowUp[]
  items       Item[]
  quotations  Quotation[]
  invoices    Invoice[]
  payments    Payment[]
  accounts    Account[]
  expenses    Expense[]
  orders      ShopOrder[]
  subscriptionRequests SubscriptionRequest[]
  membershipPlans MembershipPlan[]
  memberships     Membership[]
  suppliers       Supplier[]
  purchases       PurchaseBill[]
  creditNotes     CreditNote[]
  stockMoves      StockMove[]
  coupons         Coupon[]
  campaigns       Campaign[]
  employees       Employee[]
}

model User {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  isOwner      Boolean   @default(false)
  status       String    @default("active") // active, inactive
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId])
}

model Role {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  isSystem    Boolean          @default(false) // Owner role cannot be edited
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       User[]

  @@unique([businessId, name])
  @@index([businessId])
}

model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    String
  canView   Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([roleId, module])
}

model BusinessModule {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  module     String
  enabled    Boolean  @default(false)

  @@unique([businessId, module])
}

model ActivityLog {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  action     String
  entity     String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// ───────────── SALES (Phase 1B–1D) ─────────────

model Customer {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  address    String?
  city       String?
  state      String?
  gstin      String?
  tags       String[]    @default([])
  notes      String?
  birthday   DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  leads      Lead[]
  followUps  FollowUp[]
  quotations Quotation[]
  invoices   Invoice[]
  payments   Payment[]
  orders     ShopOrder[]
  memberships Membership[]
  creditNotes CreditNote[]

  @@index([businessId, name])
  @@index([businessId, phone])
}

model Lead {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  need         String?
  value        Decimal    @default(0) @db.Decimal(12, 2)
  stage        String     @default("new") // new, contacted, quotation, won, lost
  priority     String     @default("warm") // hot, warm, cold
  source       String?    // walk-in, phone, whatsapp, instagram, facebook, website, referral, other
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedToId String?
  notes        String?
  lostReason   String?
  closedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  followUps    FollowUp[]

  @@index([businessId, stage])
}

model FollowUp {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String
  dueAt        DateTime
  done         Boolean   @default(false)
  doneAt       DateTime?
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToId String?
  createdById  String?
  createdAt    DateTime  @default(now())

  @@index([businessId, done, dueAt])
}

model Item {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  type       String   @default("product") // product, service
  sku        String?
  hsn        String?
  unit       String   @default("pcs")
  price      Decimal  @default(0) @db.Decimal(12, 2)
  taxRate    Decimal  @default(0) @db.Decimal(5, 2)
  active     Boolean  @default(true)
  // Online shop
  mrp         Decimal? @db.Decimal(12, 2)
  description String?
  category    String?
  images      String[] @default([])
  variants    Json     @default("[]") // [{ id, name, price, mrp, inStock }] e.g. 250 g / 500 g / 1 kg, Half / Full
  showInShop  Boolean  @default(true)
  inStock     Boolean  @default(true)
  // Stock (Operations)
  trackStock  Boolean  @default(false)
  sharedStock Boolean  @default(false) // sizes share one stock in the item unit (e.g. 20 kg; 250 g order takes 0.25 kg)
  stock       Decimal  @default(0) @db.Decimal(12, 3)
  lowStockAt  Decimal  @default(0) @db.Decimal(12, 3)
  costPrice   Decimal  @default(0) @db.Decimal(12, 2)
  barcode     String?
  createdAt  DateTime @default(now())

  @@index([businessId, name])
}

model Quotation {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number     String
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id])
  date       DateTime
  validTill  DateTime?
  status     String          @default("draft") // draft, sent, accepted, rejected, converted
  interState Boolean         @default(false)
  subtotal   Decimal         @default(0) @db.Decimal(12, 2)
  discount   Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal   Decimal         @default(0) @db.Decimal(12, 2)
  total      Decimal         @default(0) @db.Decimal(12, 2)
  notes      String?
  invoiceId  String?
  createdById String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  items      QuotationItem[]

  @@unique([businessId, number])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemId      String?
  name        String
  hsn         String?
  unit        String?
  qty         Decimal   @db.Decimal(12, 3)
  rate        Decimal   @db.Decimal(12, 2)
  taxRate     Decimal   @db.Decimal(5, 2)
  amount      Decimal   @db.Decimal(12, 2) // taxable value
  taxAmount   Decimal   @db.Decimal(12, 2)
  sort        Int       @default(0)
}

model Invoice {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number      String
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  date        DateTime
  dueDate     DateTime?
  interState  Boolean       @default(false)
  subtotal    Decimal       @default(0) @db.Decimal(12, 2)
  discount    Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal    Decimal       @default(0) @db.Decimal(12, 2)
  cgst        Decimal       @default(0) @db.Decimal(12, 2)
  sgst        Decimal       @default(0) @db.Decimal(12, 2)
  igst        Decimal       @default(0) @db.Decimal(12, 2)
  roundOff    Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(12, 2)
  status      String        @default("unpaid") // unpaid, partial, paid, cancelled
  notes       String?
  shareToken  String        @unique
  quotationId String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       InvoiceItem[]
  payments    Payment[]

  @@unique([businessId, number])
  @@index([businessId, date])
  paidBillSentAt DateTime? // when the paid bill PDF went out on WhatsApp
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId    String?
  variantId String?
  name      String
  hsn       String?
  unit      String?
  qty       Decimal @db.Decimal(12, 3)
  rate      Decimal @db.Decimal(12, 2)
  taxRate   Decimal @db.Decimal(5, 2)
  amount    Decimal @db.Decimal(12, 2)
  taxAmount Decimal @db.Decimal(12, 2)
  sort      Int     @default(0)
}

model Payment {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  amount      Decimal   @db.Decimal(12, 2)
  date        DateTime
  mode        String    @default("cash") // cash, upi, card, bank, cheque
  reference   String?
  notes       String?
  refType     String?   // supplier_refund (money back from a supplier)
  refId       String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([businessId, date])
}

// ───────────── ACCOUNTS (Phase 2) ─────────────

model Account {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  type           String    @default("cash") // cash, bank, upi, other
  openingBalance Decimal   @default(0) @db.Decimal(12, 2)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  payments       Payment[]
  expenses       Expense[]

  @@unique([businessId, name])
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date        DateTime
  category    String
  amount      Decimal  @db.Decimal(12, 2) // total paid incl. GST
  taxAmount   Decimal  @default(0) @db.Decimal(12, 2) // GST input credit inside amount
  vendorName  String?
  vendorGstin String?
  billNo      String?
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  mode        String   @default("cash")
  notes       String?
  refType     String?  // supplier_payment, refund, salary (made automatically)
  refId       String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([businessId, date])
}

// ───────────── ONLINE SHOP ─────────────

model ShopOrder {
  id            String           @id @default(cuid())
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number        String
  kind          String           @default("order") // order, booking, table
  guests        Int?
  token         String           @unique
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name          String
  phone         String
  address       String?
  note          String?
  fulfilment    String           @default("pickup") // pickup, delivery
  lat           Float?
  lng           Float?
  preferredAt   DateTime?
  status        String           @default("new") // new, confirmed, ready, completed, cancelled
  subtotal      Decimal          @default(0) @db.Decimal(12, 2)
  discount      Decimal          @default(0) @db.Decimal(12, 2)
  couponCode  String?
  memberNote    String?
  taxTotal      Decimal          @default(0) @db.Decimal(12, 2)
  deliveryFee   Decimal          @default(0) @db.Decimal(12, 2)
  total         Decimal          @default(0) @db.Decimal(12, 2)
  paymentStatus String           @default("unpaid") // unpaid, paid
  paymentMode   String?
  payChoice     String           @default("cod") // online, upi, cod
  deliverySpeed String?          // normal, morning, fast
  deliveryNote  String?          // e.g. "Tomorrow 6 – 9 AM" / "Fast – 30 – 45 min"
  rzpOrderId    String?
  rzpPaymentId  String?
  invoiceId     String?
  seenAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  items         ShopOrderItem[]

  @@unique([businessId, number])
  @@index([businessId, status, createdAt])
}

model ShopOrderItem {
  id        String    @id @default(cuid())
  orderId   String
  order     ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String?
  variantId String?
  name      String
  hsn       String?
  unit      String?
  qty       Decimal   @db.Decimal(12, 3)
  rate      Decimal   @db.Decimal(12, 2)
  taxRate   Decimal   @db.Decimal(5, 2)
  amount    Decimal   @db.Decimal(12, 2)
  taxAmount Decimal   @db.Decimal(12, 2)
}

// WhatsApp OTP login for online-shop customers
// Phone numbers that passed WhatsApp OTP once – they are not asked again on any shop.
model VerifiedPhone {
  phone      String   @id
  verifiedAt DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  purpose   String   @default("shop")
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// Delivery addresses saved by OTP-verified customers (shared across BusinessMithra shops for that mobile).
model SavedAddress {
  id        String   @id @default(cuid())
  phone     String
  label     String   @default("Home") // Home, Work, Other
  address   String
  landmark  String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

// ───────────── PLATFORM (BusinessMithra super admin) ─────────────

model Plan {
  code         String   @id // free, basic, pro
  name         String
  priceMonthly Decimal  @default(0) @db.Decimal(12, 2)
  priceYearly  Decimal  @default(0) @db.Decimal(12, 2)
  maxUsers     Int      @default(1) // 0 = unlimited
  modules      String[] @default([])
  description  String?
  active       Boolean  @default(true)
  sort         Int      @default(0)
}

model SubscriptionRequest {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planCode    String
  cycle       String    @default("monthly") // monthly, yearly
  amount      Decimal   @db.Decimal(12, 2)
  paymentMode String    @default("cash") // cash, upi, bank
  reference   String?
  note        String?
  status      String    @default("pending") // pending, approved, rejected, awaiting_payment (online started)
  adminNote   String?
  requestedBy String?
  rzpOrderId  String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  validFrom   DateTime?
  validTill   DateTime?

  @@index([status, createdAt])
  @@index([businessId, createdAt])
}

// ───────────── CUSTOMER MEMBERSHIPS (vendor sells to its own customers) ─────────────

model MembershipPlan {
  id           String       @id @default(cuid())
  businessId   String
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  price        Decimal      @db.Decimal(12, 2)
  durationDays Int          @default(365)
  discountPct  Decimal      @default(0) @db.Decimal(5, 2)
  freeDelivery Boolean      @default(false)
  description  String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  memberships  Membership[]

  @@index([businessId])
}

model Membership {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId      String
  plan        MembershipPlan @relation(fields: [planId], references: [id])
  customerId  String
  customer    Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone       String
  status      String         @default("pending") // pending, active, rejected, cancelled
  startsAt    DateTime?
  endsAt      DateTime?
  pricePaid   Decimal        @default(0) @db.Decimal(12, 2)
  paymentMode String?
  reference   String?
  invoiceId   String?
  source      String         @default("store") // store, shop
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?

  @@index([businessId, status])
  @@index([businessId, phone])
}

// ───────────── OPERATIONS: stock, suppliers, purchases, returns ─────────────

model StockMove {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  itemId      String
  variantId   String?
  qty         Decimal  @db.Decimal(12, 3) // + in, - out
  reason      String   // opening, purchase, sale, order, return, purchase_return, adjust
  refType     String?
  refId       String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([businessId, itemId, createdAt])
  @@index([refType, refId])
}

model Supplier {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  gstin      String?
  address    String?
  notes      String?
  createdAt  DateTime       @default(now())
  bills      PurchaseBill[]

  @@index([businessId, name])
}

model PurchaseBill {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind        String         @default("bill") // bill, return
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  billNo      String?
  date        DateTime
  dueDate     DateTime?
  interState  Boolean        @default(false)
  subtotal    Decimal        @default(0) @db.Decimal(12, 2)
  discount    Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal    Decimal        @default(0) @db.Decimal(12, 2)
  cgst        Decimal        @default(0) @db.Decimal(12, 2)
  sgst        Decimal        @default(0) @db.Decimal(12, 2)
  igst        Decimal        @default(0) @db.Decimal(12, 2)
  roundOff    Decimal        @default(0) @db.Decimal(12, 2)
  total       Decimal        @default(0) @db.Decimal(12, 2)
  amountPaid  Decimal        @default(0) @db.Decimal(12, 2)
  status      String         @default("unpaid") // unpaid, partial, paid
  notes       String?
  createdById String?
  createdAt   DateTime       @default(now())
  items       PurchaseItem[]

  @@index([businessId, date])
}

model PurchaseItem {
  id        String       @id @default(cuid())
  billId    String
  bill      PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId    String?
  variantId String?
  name      String
  hsn       String?
  unit      String?
  qty       Decimal      @db.Decimal(12, 3)
  rate      Decimal      @db.Decimal(12, 2)
  taxRate   Decimal      @db.Decimal(5, 2)
  amount    Decimal      @db.Decimal(12, 2)
  taxAmount Decimal      @db.Decimal(12, 2)
  sort      Int          @default(0)
}

// Sales return (credit note)
model CreditNote {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number      String
  invoiceId   String?
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  date        DateTime
  subtotal    Decimal          @default(0) @db.Decimal(12, 2)
  taxTotal    Decimal          @default(0) @db.Decimal(12, 2)
  cgst        Decimal          @default(0) @db.Decimal(12, 2)
  sgst        Decimal          @default(0) @db.Decimal(12, 2)
  igst        Decimal          @default(0) @db.Decimal(12, 2)
  roundOff    Decimal          @default(0) @db.Decimal(12, 2)
  total       Decimal          @default(0) @db.Decimal(12, 2)
  settle      String           @default("refund") // refund, adjust, none
  refundMode  String?
  notes       String?
  createdById String?
  createdAt   DateTime         @default(now())
  items       CreditNoteItem[]

  @@index([businessId, date])
  @@index([invoiceId])
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  itemId       String?
  variantId    String?
  name         String
  hsn          String?
  qty          Decimal    @db.Decimal(12, 3)
  rate         Decimal    @db.Decimal(12, 2)
  taxRate      Decimal    @db.Decimal(5, 2)
  amount       Decimal    @db.Decimal(12, 2)
  taxAmount    Decimal    @db.Decimal(12, 2)
}

// ───────────── MARKETING ─────────────

model Coupon {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code        String    // stored upper-case; unique per business (checked in code)
  type        String    @default("percent") // percent, flat
  value       Decimal   @db.Decimal(10, 2)
  minOrder    Decimal   @default(0) @db.Decimal(10, 2)
  maxDiscount Decimal?  @db.Decimal(10, 2)
  validFrom   DateTime?
  validTill   DateTime?
  usageLimit  Int?
  usedCount   Int       @default(0)
  oncePerCustomer Boolean @default(true)
  showInShop  Boolean   @default(true)
  active      Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())

  @@index([businessId, code])
}

model Campaign {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  message    String
  segment    String   // all, recent, inactive, members, birthday_month, tag
  segmentArg String?
  audience   Int      @default(0)
  sent       Int      @default(0)
  failed     Int      @default(0)
  mode       String   @default("manual") // auto (AiSensy), manual (one by one)
  createdById String?
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

// ───────────── HR ─────────────

model Employee {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  role       String?
  payType    String       @default("monthly") // monthly, daily
  salary     Decimal      @default(0) @db.Decimal(10, 2) // per month or per day
  joinedOn   DateTime?
  active     Boolean      @default(true)
  notes      String?
  createdAt  DateTime     @default(now())
  attendance Attendance[]

  @@index([businessId, name])
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // business day (UTC midnight)
  status     String   // present, absent, half, leave, holiday
  note       String?

  @@unique([employeeId, date])
}
